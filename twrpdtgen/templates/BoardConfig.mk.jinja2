{% include 'LICENSE.jinja2' %}

DEVICE_PATH := device/{{ device_info.manufacturer }}/{{ device_info.codename }}

{% if skeleton == "omni" %}
# Legacy manifests may require this. Never silently mask missing modules
# when generating a modern TWRP tree.
ALLOW_MISSING_DEPENDENCIES := true
{% endif %}

{% if device_info.device_is_ab %}
# Slot-based device; recovery location is configured separately.
AB_OTA_UPDATER := true
{% if ab_partition_names %}
AB_OTA_PARTITIONS += {{ ab_partition_names | join(' ') }}
{% endif %}
{% endif %}
{% if recovery_layout == "boot" %}
BOARD_USES_RECOVERY_AS_BOOT := true
{% elif recovery_layout == "vendor_boot" %}
# Recovery ramdisk fragment detected in vendor_boot. Confirm the exact TWRP
# branch flags for this device before building/repacking vendor_boot.
{% elif recovery_layout == "unknown" %}
# TODO: Verify whether recovery is dedicated, in boot, or in vendor_boot.
{% endif %}

# Architecture
TARGET_ARCH := {{ device_info.arch.arch }}
TARGET_ARCH_VARIANT := {{ device_info.arch.arch_variant }}
TARGET_CPU_ABI := {{ device_info.arch.cpu_abi }}
TARGET_CPU_ABI2 := {{ device_info.arch.cpu_abi2 }}
TARGET_CPU_VARIANT := generic
TARGET_CPU_VARIANT_RUNTIME := {{ device_info.cpu_variant }}

{% if device_info.second_arch %}
TARGET_2ND_ARCH := {{ device_info.second_arch.arch }}
TARGET_2ND_ARCH_VARIANT := {{ device_info.second_arch.arch_variant }}
TARGET_2ND_CPU_ABI := {{ device_info.second_arch.cpu_abi }}
TARGET_2ND_CPU_ABI2 := {{ device_info.second_arch.cpu_abi2 }}
TARGET_2ND_CPU_VARIANT := generic
TARGET_2ND_CPU_VARIANT_RUNTIME := {{ device_info.second_cpu_variant }}
{% endif %}

{% if device_info.arch.bitness != 64 %}
TARGET_USES_64_BIT_BINDER := true
{% endif %}

# APEX
{% if device_info.device_uses_updatable_apex %}
DEXPREOPT_GENERATE_APEX_IMAGE := true
{% else %}
OVERRIDE_TARGET_FLATTEN_APEX := true
{% endif %}

# Bootloader
{% if device_info.bootloader_board_name %}
TARGET_BOOTLOADER_BOARD_NAME := {{ device_info.bootloader_board_name }}
{% endif %}
TARGET_NO_BOOTLOADER := true

{% if device_info.screen_density or device_info.use_vulkan %}
# Display
{% if device_info.screen_density %}
TARGET_SCREEN_DENSITY := {{ device_info.screen_density }}
{% endif %}
{% if device_info.use_vulkan %}
TARGET_USES_VULKAN := true
{% endif %}
{% endif %}

# Kernel / boot image metadata
{% if image_info.header_version != "0" %}
BOARD_BOOTIMG_HEADER_VERSION := {{ image_info.header_version }}
{% endif %}
{% if image_info.base_address is not none %}
BOARD_KERNEL_BASE := {{ image_info.base_address }}
{% endif %}
{% if image_info.cmdline %}
BOARD_KERNEL_CMDLINE := {{ image_info.cmdline }}
{% endif %}
{% if image_info.pagesize %}
BOARD_KERNEL_PAGESIZE := {{ image_info.pagesize }}
{% endif %}
{% if image_info.ramdisk_offset is not none %}
BOARD_RAMDISK_OFFSET := {{ image_info.ramdisk_offset }}
{% endif %}
{% if image_info.tags_offset is not none %}
BOARD_KERNEL_TAGS_OFFSET := {{ image_info.tags_offset }}
{% endif %}
{% if image_info.header_version != "0" %}
BOARD_MKBOOTIMG_ARGS += --header_version $(BOARD_BOOTIMG_HEADER_VERSION)
{% endif %}
{% if image_info.ramdisk_offset is not none %}
BOARD_MKBOOTIMG_ARGS += --ramdisk_offset $(BOARD_RAMDISK_OFFSET)
{% endif %}
{% if image_info.tags_offset is not none %}
BOARD_MKBOOTIMG_ARGS += --tags_offset $(BOARD_KERNEL_TAGS_OFFSET)
{% endif %}

BOARD_KERNEL_IMAGE_NAME := Image
{% if image_info.dt %}
BOARD_KERNEL_SEPARATED_DT := true
{% endif %}
{% if image_info.dtb %}
BOARD_INCLUDE_DTB_IN_BOOTIMG := true
{% endif %}
{% if image_info.dtbo %}
BOARD_KERNEL_SEPARATED_DTBO := true
{% endif %}
TARGET_KERNEL_CONFIG := {{ device_info.codename }}_defconfig
TARGET_KERNEL_SOURCE := kernel/{{ device_info.manufacturer }}/{{ device_info.codename }}

# Kernel - prebuilt
{% if image_info.kernel %}
TARGET_FORCE_PREBUILT_KERNEL := true
ifeq ($(TARGET_FORCE_PREBUILT_KERNEL),true)
TARGET_PREBUILT_KERNEL := $(DEVICE_PATH)/prebuilt/kernel
{% else %}
# No kernel was supplied/extracted. Add the matching boot.img using --boot-image
# or provide a verified kernel source before building.
{% endif %}
{% if image_info.kernel and image_info.dt %}
TARGET_PREBUILT_DT := $(DEVICE_PATH)/prebuilt/dt.img
BOARD_MKBOOTIMG_ARGS += --dt $(TARGET_PREBUILT_DT)
BOARD_KERNEL_SEPARATED_DT :=
{% endif %}
{% if image_info.kernel and image_info.dtb %}
TARGET_PREBUILT_DTB := $(DEVICE_PATH)/prebuilt/dtb.img
BOARD_MKBOOTIMG_ARGS += --dtb $(TARGET_PREBUILT_DTB)
BOARD_INCLUDE_DTB_IN_BOOTIMG :=
{% endif %}
{% if image_info.kernel and image_info.dtbo %}
BOARD_PREBUILT_DTBOIMAGE := $(DEVICE_PATH)/prebuilt/dtbo.img
BOARD_KERNEL_SEPARATED_DTBO :=
{% endif %}
{% if image_info.kernel %}
endif
{% endif %}

# Partitions
{% if device_info.device_uses_system_as_root %}
BOARD_BUILD_SYSTEM_ROOT_IMAGE := true
{% endif %}
{% if image_info.pagesize %}
BOARD_FLASH_BLOCK_SIZE := {{ image_info.pagesize|int * 64 }} # page size * 64
{% endif %}
# Only verified partition sizes may be emitted. Input image length is not
# necessarily equal to its partition size.
{% if next_options.boot_size %}
BOARD_BOOTIMAGE_PARTITION_SIZE := {{ next_options.boot_size }}
{% else %}
# TODO: Verify boot partition size from the stock partition table.
{% endif %}
{% if next_options.recovery_size %}
BOARD_RECOVERYIMAGE_PARTITION_SIZE := {{ next_options.recovery_size }}
{% elif recovery_layout == "dedicated" %}
# TODO: Verify dedicated recovery partition size.
{% endif %}

BOARD_HAS_LARGE_FILESYSTEM := true
{% if skeleton == "omni" %}
# Legacy defaults; verify against the stock fstab.
BOARD_SYSTEMIMAGE_PARTITION_TYPE := ext4
BOARD_USERDATAIMAGE_FILE_SYSTEM_TYPE := ext4
BOARD_VENDORIMAGE_FILE_SYSTEM_TYPE := ext4
{% else %}
# TODO: Set system/vendor/userdata filesystem types after checking stock
# fstab (ERoFS, ext4 and F2FS are not interchangeable).
{% endif %}
TARGET_COPY_OUT_VENDOR := vendor

{% if device_info.device_uses_dynamic_partitions %}
# Dynamic partitions detected; never guess super metadata/geometry.
{% if dynamic_partition_names %}
# Detected logical partitions: {{ dynamic_partition_names | join(' ') }}
{% endif %}
{% if next_options.super_size and next_options.dynamic_group_size and dynamic_partition_names %}
BOARD_SUPER_PARTITION_SIZE := {{ next_options.super_size }}
BOARD_SUPER_PARTITION_GROUPS := {{ device_info.manufacturer }}_dynamic_partitions
BOARD_{{ device_info.manufacturer|upper }}_DYNAMIC_PARTITIONS_PARTITION_LIST := {{ dynamic_partition_names | join(' ') }}
BOARD_{{ device_info.manufacturer|upper }}_DYNAMIC_PARTITIONS_SIZE := {{ next_options.dynamic_group_size }}
{% else %}
# TODO: Supply verified --super-size and --dynamic-group-size before
# building a super image. Retrofit dynamic partitions need separate review.
{% endif %}
{% endif %}
{% if "lzma" in image_info.ramdisk_compression %}
LZMA_RAMDISK_TARGETS := recovery
{% endif %}

# Platform
TARGET_BOARD_PLATFORM := {{ device_info.platform }}

# Recovery
TARGET_RECOVERY_FSTAB := $(DEVICE_PATH)/recovery.fstab
{% if image_info.dtbo and not device_info.device_is_ab %}
BOARD_INCLUDE_RECOVERY_DTBO := true
{% endif %}
{% if device_info.device_pixel_format %}
TARGET_RECOVERY_PIXEL_FORMAT := {{ device_info.device_pixel_format }}
{% endif %}
TARGET_USERIMAGES_USE_EXT4 := true
TARGET_USERIMAGES_USE_F2FS := true

{% if security_patch %}
# Preserved from stock firmware; do not substitute artificial patch levels.
VENDOR_SECURITY_PATCH := {{ security_patch }}
{% endif %}
{% if image_info.sigtype == "AVBv2" %}
# AVBv2 detected. Signing keys and rollback indices are device specific.
# TODO: Configure BoardConfig AVB parameters after examining the stock vbmeta
# chain; do not use test keys or disable verification by default.
{% endif %}
# Android platform version comes from the selected recovery source tree.

# TWRP Configuration
TW_THEME := portrait_hdpi
TW_EXTRA_LANGUAGES := true
TW_SCREEN_BLANK_ON_BOOT := true
TW_INPUT_BLACKLIST := "hbtp_vm"
TW_USE_TOOLBOX := true
{% if device_info.device_is_ab %}
TW_INCLUDE_REPACKTOOLS := true
{% endif %}
