{% include 'LICENSE.jinja2' %}

# Inherit from those products. Most specific first.
{% if device_info.arch.bitness == 64 %}
$(call inherit-product, $(SRC_TARGET_DIR)/product/core_64_bit.mk)
{% endif %}
$(call inherit-product, $(SRC_TARGET_DIR)/product/full_base_telephony.mk)

# Inherit some common Omni stuff.
{% if product_prefix == "omni" %}
$(call inherit-product, vendor/omni/config/common.mk)
{% else %}
$(call inherit-product, vendor/twrp/config/common.mk)
{% endif %}

# Inherit from {{ device_info.codename }} device
$(call inherit-product, device/{{ device_info.manufacturer }}/{{ device_info.codename }}/device.mk)

# Copy the generated device-specific recovery overlay into the recovery ramdisk.
# Without this, recovery/root exists in the source tree but none of its init,
# firmware, module or VINTF additions are actually present in the built image.
PRODUCT_COPY_FILES += $(call find-copy-subdir-files,*,device/{{ device_info.manufacturer }}/{{ device_info.codename }}/recovery/root,recovery/root)

PRODUCT_DEVICE := {{ device_info.codename }}
PRODUCT_NAME := {{ product_prefix }}_{{ device_info.codename }}
{% if device_info.brand %}
PRODUCT_BRAND := {{ device_info.brand }}
{% endif %}
{% if device_info.model %}
PRODUCT_MODEL := {{ device_info.model }}
{% endif %}
PRODUCT_MANUFACTURER := {{ device_info.manufacturer }}

{% if device_info.gms_clientid_base %}
PRODUCT_GMS_CLIENTID_BASE := {{ device_info.gms_clientid_base }}
{% endif %}
{% if device_info.build_description %}
PRODUCT_BUILD_PROP_OVERRIDES += \
    PRIVATE_BUILD_DESC="{{ device_info.build_description }}"
{% endif %}
{% if device_info.build_fingerprint %}
BUILD_FINGERPRINT := {{ device_info.build_fingerprint }}
{% endif %}

